# ============================================================
# SchemeSaathi AI — Root .env.example
# Copy this file to .env and configure values.
# NEVER commit .env to git.
# ============================================================

# --- DEMO MODE (set true for hackathon demo / local dev) ---
DEMO_MODE=true

# --- Database ---
DATABASE_URL=sqlite:///./backend/schemesaathi.db
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/schemesaathi

# --- AWS Configuration (required only when DEMO_MODE=false) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: use named AWS profile
# AWS_PROFILE=

# --- Amazon Bedrock ---
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- Amazon S3 ---
S3_BUCKET_NAME=schemesaathi-documents
S3_UPLOAD_PREFIX=uploads/

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
