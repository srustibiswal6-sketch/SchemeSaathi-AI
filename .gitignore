# SchemeSaathi AI — .gitignore
# ============================================================

# Environment files (NEVER commit)
.env
.env.local
.env.*.local
*.pem
credentials

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# Database files
*.db
*.sqlite
*.sqlite3

# Uploaded documents (private citizen files)
backend/uploads/
uploads/

# Node.js
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/.vite/

# IDE / OS
.DS_Store
._*
*/._*
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# AWS
.aws/

# Logs
*.log
logs/

# Coverage
.coverage
htmlcov/
