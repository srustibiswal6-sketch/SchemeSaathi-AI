# Database connection string (defaults to SQLite for local development)
DATABASE_URL=sqlite:///./schemesaathi.db
# Example for PostgreSQL deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/schemesaathi

# AI / LLM Configuration (Optional - provides grounded explanations via OpenAI or AWS Bedrock)
OPENAI_API_KEY=

# AWS Configuration (Optional - for future AWS Textract document OCR and AWS Bedrock integration)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
