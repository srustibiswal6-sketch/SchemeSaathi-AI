# ============================================================
# SchemeSaathi AI — Backend Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to git.
# ============================================================

# --- Application Mode ---
# Set DEMO_MODE=true for local development/hackathon demo.
# In demo mode: mock AI responses, mock document extraction, local search.
DEMO_MODE=true

# --- Database ---
# SQLite (local dev default):
DATABASE_URL=sqlite:///./schemesaathi.db
# PostgreSQL (deployment):
# DATABASE_URL=postgresql://user:password@localhost:5432/schemesaathi

# --- AWS Configuration ---
# Required when DEMO_MODE=false for real Bedrock, S3, Textract
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: use named profile from ~/.aws/credentials instead of keys
AWS_PROFILE=

# --- Amazon Bedrock ---
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- Amazon S3 ---
S3_BUCKET_NAME=schemesaathi-documents
S3_UPLOAD_PREFIX=uploads/

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Legacy / Optional ---
# OPENAI_API_KEY=
